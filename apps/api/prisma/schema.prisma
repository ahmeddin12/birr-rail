// Birr Rail database schema.
// The connection URL lives in prisma.config.ts (Prisma 7), not here.
// Conventions: UUID ids generated by Postgres (so raw SQL inserts get them too),
// snake_case table and column names, timestamps as timestamptz (stored in UTC).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  apiKeys         ApiKey[]
  payments        Payment[]
  idempotencyKeys IdempotencyKey[]

  @@map("merchants")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  /// First characters of the key, safe to display so merchants can tell keys apart.
  prefix     String
  /// SHA-256 of the full key, hex encoded. The key itself is never stored.
  keyHash    String    @unique @map("key_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([merchantId])
  @@map("api_keys")
}

/// Changes only through PaymentsService.transition(); see payment-state.ts for the allowed moves.
enum PaymentStatus {
  created
  pending
  succeeded
  failed
  expired
  refunded

  @@map("payment_status")
}

model Payment {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String         @map("merchant_id") @db.Uuid
  merchant          Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  /// Integer santim. The migration adds CHECK (amount_minor > 0).
  amountMinor       BigInt         @map("amount_minor")
  status            PaymentStatus  @default(created)
  provider          String
  /// The provider's own transaction reference. Our id is sent to the provider as its tx_ref.
  providerRef       String?        @map("provider_ref")
  merchantReference String?        @map("merchant_reference")
  checkoutUrl       String?        @map("checkout_url")
  returnUrl         String?        @map("return_url")
  metadata          Json           @default("{}")
  /// Incremented by every applied transition.
  version           Int            @default(0)
  expiresAt         DateTime?      @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  events            PaymentEvent[]

  @@unique([provider, providerRef])
  @@index([merchantId])
  @@map("payments")
}

/// Append-only history: one row per applied status change.
model PaymentEvent {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId  String        @map("payment_id") @db.Uuid
  payment    Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  fromStatus PaymentStatus @map("from_status")
  toStatus   PaymentStatus @map("to_status")
  /// Why it happened, e.g. "provider_checkout_created" or "webhook:chapa".
  reason     String
  /// The payment's version after this change. Unique per payment, so a version can never be applied twice.
  version    Int
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([paymentId, version])
  @@map("payment_events")
}

enum IdempotencyStatus {
  in_progress
  completed

  @@map("idempotency_status")
}

/// One row per (merchant, Idempotency-Key). The unique constraint decides which request runs;
/// every other request with the same key gets the stored response, a 409 or a 422.
model IdempotencyKey {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId     String            @map("merchant_id") @db.Uuid
  merchant       Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  key            String            @db.VarChar(255)
  requestMethod  String            @map("request_method")
  requestPath    String            @map("request_path")
  /// SHA-256 of method, path and canonical body. A different request reusing the key gets a 422.
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(in_progress)
  /// While in progress, other requests get a 409 until this passes. After it, the original is
  /// presumed crashed and its outcome is recorded as unknown.
  lockedUntil    DateTime          @map("locked_until") @db.Timestamptz(6)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)

  @@unique([merchantId, key])
  @@map("idempotency_keys")
}
