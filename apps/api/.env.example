# Local development only. Copy to .env and never commit .env.
# Values match infra/docker-compose.yml. Sandbox only: no live provider keys, ever.
NODE_ENV=development
BIRRRAIL_PORT=3000
# fatal | error | warn | info | debug | trace | silent
BIRRRAIL_LOG_LEVEL=info
BIRRRAIL_DATABASE_URL=postgresql://birrrail:birrrail@127.0.0.1:5440/payments
# Optional, shown with their defaults.
# BIRRRAIL_PAYMENT_TTL_MINUTES=30
# BIRRRAIL_IDEMPOTENCY_LEASE_SECONDS=60
# BIRRRAIL_SANDBOX_CHECKOUT_URL=http://localhost:3000/sandbox/checkout
# BIRRRAIL_SANDBOX_SLOW_MS=3000
# e2e tests refuse to run unless the database name ends with _test.
BIRRRAIL_TEST_DATABASE_URL=postgresql://birrrail:birrrail@127.0.0.1:5440/payments_test
